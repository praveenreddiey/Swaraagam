# Public browser configuration. These values are embedded at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare's always-pass site key below is for local development only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server-only secrets. Never prefix these with NEXT_PUBLIC_ or commit real values.
# Cloudflare's matching always-pass secret below is for local development only.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_EXPECTED_HOSTNAMES=localhost
RESEND_API_KEY=re_replace_with_a_real_resend_api_key
ENQUIRY_TO_EMAIL=you@example.com
ENQUIRY_FROM_EMAIL=Swaraagam Enquiries <enquiries@your-verified-domain.com>
RATE_LIMIT_SALT=replace_with_a_long_random_value

# Comma-separated origins allowed to call the endpoint from a browser.
ALLOWED_ORIGINS=http://localhost:3000
